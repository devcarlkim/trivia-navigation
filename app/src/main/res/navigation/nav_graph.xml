<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startGameFragment">

    <fragment
        android:id="@+id/startGameFragment"
        android:name="com.example.titlefragment.StartGameFragment"
        android:label="@string/start_game_title">
        <action
            android:id="@+id/action_startGameFragment_to_gameWonFragment"
            app:destination="@id/gameWonFragment" />
        <action
            android:id="@+id/action_startGameFragment_to_gameOverFragment"
            app:destination="@id/gameOverFragment" />
    </fragment>

    <fragment
        android:id="@+id/gameWonFragment"
        android:name="com.example.titlefragment.GameWonFragment"
        android:label="@string/game_won_title">
        <action
            android:id="@+id/action_gameWonFragment_to_startGameFragment"
            app:destination="@id/startGameFragment"
            app:popUpTo="@id/startGameFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/gameOverFragment"
        android:name="com.example.titlefragment.GameOverFragment"
        android:label="@string/game_over_title">
        <action
            android:id="@+id/action_gameOverFragment_to_startGameFragment"
            app:destination="@id/startGameFragment"
            app:popUpTo="@id/startGameFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>

